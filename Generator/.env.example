# 공개 Admin 주소
MORA_ADMIN_URL=https://mora.junx.dev

# 첫 실행에서 10자리 PIN을 Admin에서 승인합니다.
# 승인 후 Generator/.mora-worker.json이 생성되며 이후에는 자동으로 재사용됩니다.
MORA_WORKER_NAME="Mac Generator"

# 선택: YouTube 로그인이 필요한 경우 Netscape 형식 쿠키 파일
# YTDLP_COOKIE_FILE=/absolute/path/to/cookies.txt

# 선택: 화자 분리를 활성화합니다.
# HF_TOKEN=

# 선택: 모델과 임시 작업 위치
# MORA_CACHE_ROOT=/absolute/path/to/cache
# MORA_WORK_ROOT=/absolute/path/to/work
