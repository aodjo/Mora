{
  "name": "mora-lyrics",
  "version": "0.1.0",
  "description": "Timed lyrics from Mora — line and word timings for a song you already have the words to.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "lyrics",
    "karaoke",
    "timing",
    "alignment",
    "lrc",
    "ttml",
    "webvtt"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test/*.test.js"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "@types/node": "^24.1.0"
  }
}
