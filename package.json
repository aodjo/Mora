{
  "name": "mora",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "prebuild": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "corepack pnpm --filter @mora/songtitle build && tsc -p tsconfig.json && corepack pnpm --dir Admin build",
    "build:services": "corepack pnpm --filter @mora/songtitle build && tsc -p tsconfig.json",
    "check": "corepack pnpm --filter @mora/songtitle build && tsc -p tsconfig.json --noEmit && corepack pnpm --dir Admin check",
    "format": "prettier --write \"{Admin,Collector,Generator,Server,packages,test}/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"{Admin,Collector,Generator,Server,packages,test}/**/*.{ts,tsx}\"",
    "test": "npm run build:services && node --test dist/test/*.test.js && npm run test:align",
    "test:align": "python3 Generator/python/test_alignment.py",
    "start": "node dist/Generator/src/worker-cli.js",
    "dev": "npm run dev:generator",
    "dev:admin": "corepack pnpm --dir Admin dev",
    "dev:collector": "corepack pnpm --filter @mora/songtitle build && tsx Collector/src/cli.ts",
    "collector": "corepack pnpm dev:collector",
    "generator": "corepack pnpm build:services && Generator/scripts/run-macos.sh",
    "dev:generator": "tsx Generator/src/worker-cli.ts",
    "generator:setup:mac": "Generator/scripts/setup-macos.sh",
    "generator:self-test:mac": "Generator/scripts/self-test-macos.sh",
    "generator:smoke:mac": "node Generator/scripts/smoke-test-macos.mjs",
    "generator:run:mac": "Generator/scripts/run-macos.sh",
    "dev:worker": "wrangler dev --config Server/wrangler.jsonc",
    "worker:types": "wrangler types Server/worker-configuration.d.ts --config Server/wrangler.jsonc",
    "worker:build": "wrangler deploy --dry-run --config Server/wrangler.jsonc --outdir .wrangler-dist",
    "worker:deploy": "wrangler deploy --config Server/wrangler.jsonc",
    "infra:login": "wrangler login",
    "infra:provision": "node Server/scripts/provision-cloudflare.mjs",
    "infra:status": "wrangler whoami && wrangler d1 list --config Server/wrangler.jsonc && wrangler r2 bucket list --config Server/wrangler.jsonc && wrangler queues list --config Server/wrangler.jsonc",
    "local:setup": "node Server/scripts/setup-local.mjs && corepack pnpm d1:migrate:local",
    "d1:migrate:local": "wrangler d1 migrations apply mora-public --local --config Server/wrangler.jsonc && wrangler d1 migrations apply mora-admin --local --config Server/wrangler.jsonc",
    "d1:migrate:remote": "wrangler d1 migrations apply mora-public --remote --config Server/wrangler.jsonc && wrangler d1 migrations apply mora-admin --remote --config Server/wrangler.jsonc",
    "dump:publish": "node Server/scripts/publish-dump.mjs",
    "collector:image": "docker compose -f Collector/docker-compose.yml build",
    "collector:pair": "docker compose -f Collector/docker-compose.yml run --rm collector",
    "collector:up": "docker compose -f Collector/docker-compose.yml up -d",
    "collector:logs": "docker compose -f Collector/docker-compose.yml logs -f",
    "collector:down": "docker compose -f Collector/docker-compose.yml down"
  },
  "dependencies": {
    "@mora/songtitle": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.1.0",
    "prettier": "^3.9.6",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "wrangler": "^4.118.0"
  }
}
