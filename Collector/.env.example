MORA_ADMIN_URL=http://localhost:8787
MORA_COLLECTOR_TOKEN=mora_replace_me
MORA_USER_AGENT=Mora/0.1 (contact@example.com)
COLLECTOR_DAILY_BUDGET=300
COLLECTOR_INTERVAL_MS=86400000
COLLECTOR_ONCE=1

# 비워두면 모든 SongTitle provider를 사용합니다.
# SONGTITLE_PROVIDERS=melon,bugs,genie,flo,vibe,genius,shazam,lyricfind
SONGTITLE_TIMEOUT_MS=12000
SONGTITLE_BROWSER=0
SONGTITLE_HEADFUL=0

# 선택 API 키
# GENIUS_ACCESS_TOKEN=
# LYRICFIND_API_KEY=
# LYRICFIND_TERRITORY=KR

# 외부 LyricsProvider로 완전히 교체할 때만 설정합니다.
# LYRICS_LIBRARY_MODULE=/absolute/path/to/provider.js
